# Copiar a .env y completar valores reales (NO subir .env a git)

SECRET_KEY=cambia-esta-clave-larga
FLASK_DEBUG=1

# --- Frontend (Vercel) ---
FRONTEND_URL=https://tu-proyecto.vercel.app
